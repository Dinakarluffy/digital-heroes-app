# Next.js App URL (Set to your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://digital-heroes.vercel.app

# Supabase Configuration (From your new Supabase Project -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe Configuration (Test Mode API keys from Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Platform Parameters (§ 04, § 06, § 07)
NEXT_PUBLIC_MONTHLY_PLAN_PRICE=19
NEXT_PUBLIC_YEARLY_PLAN_PRICE=180
NEXT_PUBLIC_MIN_CHARITY_PCT=10
NEXT_PUBLIC_TIER_5_SHARE=0.40
NEXT_PUBLIC_TIER_4_SHARE=0.35
NEXT_PUBLIC_TIER_3_SHARE=0.25
